#include <Wire.h>

const int MPU_ADDR = 0x68;

const int AIN1 = 8;
const int AIN2 = 7;
const int PWMA = 9;
const int BIN1 = 2;
const int BIN2 = 4;
const int PWMB = 5;

double Kp = 44.0;   
double Ki = 0.7;
double Kd = 1.7 ;   

float accAngleOffset = 6;
float gyroYOffset = 0;

float angle = 0;
float alpha = 0.90;

unsigned long lastTime;
double integral = 0;
double lastError = 0;
double outputFilter = 0;
double output = 0;
int loopCount = 0;
const int MIN_PWM = 70;


void setup() {
  Serial.begin(9600);
  Wire.begin();

  pinMode(AIN1, OUTPUT); pinMode(AIN2, OUTPUT); pinMode(PWMA, OUTPUT);
  pinMode(BIN1, OUTPUT); pinMode(BIN2, OUTPUT); pinMode(PWMB, OUTPUT);

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0);
  Wire.endTransmission(true);

  Serial.println("Calibrating gyro, keep still...");
  long sum = 0;
  for (int i = 0; i < 200; i++) {
    int16_t gx, gy, gz;
    readGyro(gx, gy, gz);
    sum += gy;
    delay(3);
  }
  gyroYOffset = sum / 200.0;
  Serial.println("Calibration done. Starting balance loop.");

  lastTime = micros();
}

void loop() {
  int16_t ax, ay, az, gx, gy, gz;
  readAccel(ax, ay, az);
  readGyro(gx, gy, gz);

  float accAngle = atan2(-(float)az, -(float)ax) * 180.0 / PI;
  accAngle -= accAngleOffset;

  float gyroRate = (gy - gyroYOffset) / 131.0;

  unsigned long now = micros();
  float dt = (now - lastTime) / 1000000.0;
  lastTime = now;

  angle = alpha * (angle + gyroRate * dt) + (1 - alpha) * accAngle;

  double error = 0 - angle;
  outputFilter = outputFilter * 0.999 + output * 0.001;
  error -= outputFilter * 0.01;
  integral += error * dt;
  integral = constrain(integral, -50, 50);  
  double derivative = -gyroRate;
  lastError = error;

  output = Kp * error + Ki * integral + Kd * derivative;
  output = constrain(output, -255, 255);

  if (abs(angle) > 45) {
    output = 0;
    integral = 0;
  }

  driveMotors(output);

  loopCount++;
  if (loopCount >= 10) {
    Serial.print("angle="); Serial.print(angle);
    Serial.print("  output="); Serial.println(output);
    loopCount = 0;
  }

  delay(5);  
}

void readAccel(int16_t &ax, int16_t &ay, int16_t &az) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 6, true);
  ax = Wire.read() << 8 | Wire.read();
  ay = Wire.read() << 8 | Wire.read();
  az = Wire.read() << 8 | Wire.read();
}

void readGyro(int16_t &gx, int16_t &gy, int16_t &gz) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x43);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 6, true);
  gx = Wire.read() << 8 | Wire.read();
  gy = Wire.read() << 8 | Wire.read();
  gz = Wire.read() << 8 | Wire.read();
}

void driveMotors(double output) {
  bool forward = output > 0;
  int speed = (int)abs(output);

  if (speed < 5) {
    speed = 0;                        
  } else {
    speed = map(speed, 5, 255, MIN_PWM, 255);
  }

  if (forward) {
    digitalWrite(AIN1, HIGH); digitalWrite(AIN2, LOW);
    digitalWrite(BIN1, HIGH); digitalWrite(BIN2, LOW);
  } else {
    digitalWrite(AIN1, LOW); digitalWrite(AIN2, HIGH);
    digitalWrite(BIN1, LOW); digitalWrite(BIN2, HIGH);
  }
  analogWrite(PWMA, speed);
  analogWrite(PWMB, speed);
}
